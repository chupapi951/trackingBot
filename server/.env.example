# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/tracking_bot

# Server port
PORT=4000

# Telegram bot token (from @BotFather) — used to validate initData
BOT_TOKEN=your_telegram_bot_token_here

# Set to "true" to allow unauthenticated dev login via header (local development only)
# NEVER enable in production!
DEV_AUTH=false

# Public base url where uploaded files are served from (optional, defaults to request host)
PUBLIC_URL=
